    "Quiet %lld" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "조용함 %lld" } } } },
    "This session started before the app. Its exact state shows from its next news." : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "앱보다 먼저 켜진 세션이에요. 다음 소식부터 정확한 상태가 보여요" } } } },
    "Shown with its next news" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "다음 소식 때 보여요" } } } },
