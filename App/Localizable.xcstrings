    "Tasks" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "할 일" } } } },
    "Skill" : { "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "스킬" } } } },
